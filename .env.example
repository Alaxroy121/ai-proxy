# Copy to .env and fill in
# Comma-separated OpenRouter keys. Rotation happens in order, failover on 402/429/401.
API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# Upstream - keep as OpenRouter. Works for any OpenAI-compatible provider too.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Optional: protect your proxy with its own key. Clients must send: Authorization: Bearer <PROXY_API_KEY>
# Leave empty to allow open access (not recommended on VPS).
PROXY_API_KEY=

# OpenRouter recommended headers (https://openrouter.ai/docs/requests)
HTTP_REFERER=https://yourdomain.com
X_TITLE=Key Rotating Proxy

# Rotation: strict 1->2->3, new key EVERY request (no cooldowns).
# Preemptive budget: switch keys BEFORE the provider rate-limits/errors.
# 0 = unlimited. Counts real usage.total_tokens when reported, else estimates.
MAX_TOKENS_PER_KEY=50000
MAX_RETRIES_PER_REQUEST=10        # max keys to try per client request
REQUEST_TIMEOUT_SEC=120
PORT=8000
KEYS_FILE=keys.txt                # local fallback when MONGODB_URI is empty

# Durable storage for unstable servers (recommended).
# Free MongoDB Atlas cluster -> Connect -> copy connection string.
# Keys + token counters then survive disk wipes/restarts.
# Empty = local keys.txt + in-memory counters.
MONGODB_URI=
MONGODB_DB=ai_proxy
USAGE_WAL=usage.wal              # local write-ahead log for usage deltas
FLUSH_SEC=5                     # outbox -> store interval (seconds)

# Telegram DM control (optional but recommended)
# 1. Talk to @BotFather -> /newbot -> copy token
# 2. DM @userinfobot to get your numeric ID
# 3. Bot shows a professional / command menu + buttons automatically.
# 4. Live progress pushes at 50/80/100% per key; optional digest below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789       # your Telegram user id, comma-separated for team
LIVE_DIGEST_MIN=0                 # auto /stats push every N min when usage changed (0 = off)
