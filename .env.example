# Copy to .env and fill in
# Comma-separated OpenRouter keys. Rotation happens in order, failover on 402/429/401.
API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# Upstream - keep as OpenRouter. Works for any OpenAI-compatible provider too.
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1

# Optional: protect your proxy with its own key. Clients must send: Authorization: Bearer <PROXY_API_KEY>
# Leave empty to allow open access (not recommended on VPS).
PROXY_API_KEY=

# OpenRouter recommended headers (https://openrouter.ai/docs/requests)
HTTP_REFERER=https://yourdomain.com
X_TITLE=Key Rotating Proxy

# Rotation tuning
COOLDOWN_RATE_LIMIT_SEC=60        # cooldown on 429 rate-limit
COOLDOWN_EXHAUSTED_SEC=3600       # cooldown on 402 insufficient credits / 401 invalid key
MAX_RETRIES_PER_REQUEST=10        # max keys to try per client request
REQUEST_TIMEOUT_SEC=120
PORT=8000
KEYS_FILE=keys.txt                # persists keys added via Telegram

# Telegram DM control (optional but recommended)
# 1. Talk to @BotFather -> /newbot -> copy token
# 2. DM @userinfobot to get your numeric ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789       # your Telegram user id, comma-separated for team
